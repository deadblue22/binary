{
  "name": "binaryd",
  "version": "0.2.0",
  "description": "Binary server: manages Claude Code sessions through the official Claude Agent SDK",
  "private": true,
  "license": "MIT",
  "type": "module",
  "bin": {
    "binaryd": "bin/binaryd"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/main.js serve",
    "test": "tsc -p tsconfig.json && node --test --test-concurrency=1 \"dist/test/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.304",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2"
  }
}
